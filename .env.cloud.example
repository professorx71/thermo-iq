# ===== PBF Temperature Dashboard v6.2.6 Cloud Edition =====
LICOR_API_TOKEN=PASTE_PRIVATE_LICOR_TOKEN_HERE
LICOR_API_BASE=https://api.licor.cloud

# SENDER for alarm emails and text messages (recipients are set on the Settings page)
GMAIL_SENDER=your-alert-sender@gmail.com
GMAIL_APP_PASSWORD=PASTE_GMAIL_APP_PASSWORD_HERE
# Optional, for a non-Gmail sender: SMTP_HOST=smtp.your-provider.com and SMTP_PORT=587
# First-run email recipient(s), comma-separated; afterwards use Settings.
ALERT_EMAIL=recipient@example.com
# Optional separate sender for the maintenance report (same mail server):
# REPORT_SENDER=reports@yourdomain.com
# REPORT_SENDER_PASSWORD=report_sender_password

# IMPORTANT: keep FALSE during initial cloud testing to avoid duplicate alarms
# with the GMKtec mini-PC. Change to true only when cloud becomes PRIMARY.
NOTIFICATIONS_ENABLED=false
DEPLOYMENT_ROLE=CLOUD-TEST

# Existing hashed credentials from the mini-PC may be copied here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=